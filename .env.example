APP_NAME=BatikWistara
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=batik_wistara
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# WhatsApp Configuration (Fonnte API)
FONNTE_TOKEN=your_fonnte_api_token_here
ADMIN_PHONE=628xxxxxxxxxx

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# AI AGENT - PILIH SALAH SATU PROVIDER
# ========================================

# OPTION 1: GROQ (GRATIS - RECOMMENDED!)
# Daftar: https://console.groq.com
# Free tier: 30 requests/min, sangat cepat!
AI_AGENT_PROVIDER=groq
AI_AGENT_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
AI_AGENT_MODEL=llama-3.3-70b-versatile
# Model lain: llama-3.1-70b-versatile, mixtral-8x7b-32768

# OPTION 2: GOOGLE GEMINI (GRATIS)
# Daftar: https://aistudio.google.com/apikey
# Free tier: 60 requests/min
#AI_AGENT_PROVIDER=gemini
#AI_AGENT_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx
#AI_AGENT_MODEL=gemini-2.0-flash-exp
# Model lain: gemini-1.5-flash, gemini-1.5-pro

# OPTION 3: OPENROUTER (FREEMIUM)
# Daftar: https://openrouter.ai/keys
# Beberapa model gratis dengan limit
#AI_AGENT_PROVIDER=openrouter
#AI_AGENT_API_KEY=sk-or-v1-xxxxxxxxxxxxx
#AI_AGENT_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Model gratis lain: google/gemini-flash-1.5:free

# OPTION 4: OLLAMA (100% GRATIS - LOCAL)
# Install: https://ollama.com/download
# Run: ollama run llama3.2
# Tidak perlu API key, running di komputer sendiri!
#AI_AGENT_PROVIDER=ollama
#AI_AGENT_API_KEY=
#AI_AGENT_API_URL=http://localhost:11434/v1
#AI_AGENT_MODEL=llama3.2
# Model lain: mistral, phi3, qwen2.5

# OPTION 5: OPENAI (BERBAYAR)
# Daftar: https://platform.openai.com/api-keys
#AI_AGENT_PROVIDER=openai
#AI_AGENT_API_KEY=sk-proj-xxxxxxxxxxxxx
#AI_AGENT_MODEL=gpt-4o-mini
# Model lain: gpt-4o, gpt-3.5-turbo

# GENERAL SETTINGS
AI_AGENT_TEMPERATURE=0.7
AI_AGENT_MAX_TOKENS=1000

# ========================================
# GROQ AI CONFIGURATION (FREE!)
# ========================================
# Daftar gratis di: https://console.groq.com
# Free tier: 30 req/min, 14,400 req/day
# Response time: < 1 detik (super cepat!)

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1000

# Model Options (pilih salah satu):
# - llama-3.3-70b-versatile (RECOMMENDED - terbaru & terbaik)
# - llama-3.1-70b-versatile (sangat bagus)
# - mixtral-8x7b-32768 (context window panjang)
# - gemma2-9b-it (ringan & cepat)

# Session (untuk conversation history)
SESSION_DRIVER=file
SESSION_LIFETIME=120
